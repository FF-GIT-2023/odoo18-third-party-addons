<?xml version="1.0" encoding="UTF-8"?>
<!--Adding the logo in the pos Receipt-->
<templates id="point_of_sale.receipt_template" xml:space="preserve">

    <t t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension"
       owl="1">

        <xpath expr="//div/div[hasclass('pos-receipt-contact')]/div[6]"
               position="replace"/>
    </t>

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension"
       owl="1">

        <xpath expr="//div[hasclass('pos-receipt')]/ReceiptHeader"
               position="before">
            <img t-if="this.env.services.pos.config.logo_option === 'both'"
                 t-attf-src="/web/image?model=pos.config&amp;field=image&amp;id={{ this.env.services.pos.config.id }}"
                 style="width:10%"/>
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt')]/div[3]" position="replace">
            <div class="pos-receipt-order-data">
                <p>Powered by Smatek</p>
                <div t-esc="props.data.name"/>
                <div id="order-date" t-esc="props.data.date"/>
                <div class="barcode-area" style="text-align: center; margin-top: 10px;">
                    <svg id="barcode" style="box-shadow: 0 0 20px rgba(0,139,253,0.25); width: 300px; margin: 30px 0px 30px 0px;"/>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsbarcode/3.11.3/JsBarcode.all.min.js" onload="generateBarcode()"/>
                    <script>
                        function generateBarcode() {
                            JsBarcode("#barcode", "<t t-esc='getBarcodeValue'/>", {
                                format: "CODE128",
                                displayValue: true,
                                height: 40,
                                width: 2,
                                margin: 10,
                                fontSize: 14
                            });
                        }
                    </script>
                </div>
            </div>
        </xpath>
    </t>

    <t t-name="point_of_sale_logo.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='pos.config.module_pos_restaurant']" position="replace">
            <button t-att-class="buttonClass"
                    t-att-disabled="!pos.get_order()?.get_orderlines()?.length"
                    t-on-click="clickPrintBill">
                <i class="fa fa-print me-1"></i>Print
            </button>
            <t t-if="pos.config.iface_printbill">
                <button t-att-class="buttonClass" t-on-click="clickTableGuests">
                    <span t-esc="currentOrder?.getCustomerCount() || 0"
                          class="px-2 py-1 rounded-circle text-bg-dark fw-bolder small me-1"/>
                    <span>Guests</span>
                </button>
            </t>
        </xpath>
    </t>

</templates>
