<?xml version="1.0" encoding="utf-8" ?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt')]/div[3]" position="replace"/>
        <xpath expr="//ReceiptHeader" position="after">
            <t t-if="props.data.headerData.partner">
                <t t-if="props.data.headerData.partner.name">
                    <div>Customer:
                        <t t-esc="props.data.headerData.partner.name"/>
                    </div>
                </t>
                <t t-if="props.data.headerData.partner.phone">
                    <div>Phone:
                        <t t-esc="props.data.headerData.partner.phone"/>
                    </div>
                </t>
            </t>
        </xpath>

        <xpath expr="//OrderWidget" position="replace">
            <div style="width: 100%;">
                <t t-if="props.data.orderlines">
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; margin-top: 5px; font-size: 12px;">
                        <thead>
                            <tr style="border-top: 1px solid #000; border-bottom: 1px solid #000;">
                                <th style="width: 32%; text-align: left; padding: 4px 0;">Product</th>
                                <th style="width: 15%; text-align: center;">Qty</th>
                                <th style="width: 20%; text-align: right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="props.data.orderlines" t-as="orderline" t-key="orderline_index">
                                <tr>
                                    <td style="padding: 5px 0; line-height: 1.1; word-break: break-word; vertical-align: top;">
                                        <div>
                                            <t t-esc="orderline.productName"/>
                                        </div>
                                        <t t-if="orderline.discount > 0">
                                            <div style="font-size: 10px; color: #555;">
                                                Disc: <t t-esc="orderline.discount"/>%
                                            </div>
                                        </t>
                                    </td>

                                    <td style="text-align: center; vertical-align: top; padding-top: 5px;">
                                        <div style="white-space: nowrap;">
                                            <t t-esc="orderline.qty"/>
                                        </div>
                                    </td>
                                    <td style="text-align: right; vertical-align: top; padding-top: 5px;">
                                        <t t-esc="orderline.price"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </xpath>
    </t>
</templates>
