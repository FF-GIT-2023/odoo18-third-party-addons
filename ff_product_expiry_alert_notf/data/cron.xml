<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="ir_cron_product_expiry_alert" model="ir.cron">
            <field name="name">Product Expiry Alert Notification</field>
            <field name="model_id" ref="stock.model_stock_lot" />
            <field name="code">model.expiry_alert_mail_send()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True" />
        </record>
        <record id="ir_cron_product_expired_remove" model="ir.cron">
            <field name="name">Expired Product Remove</field>
            <field name="model_id" ref="stock.model_stock_lot" />
            <field name="code">model.expired_product_remove()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
