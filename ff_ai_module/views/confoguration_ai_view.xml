<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ai_config_form" model="ir.ui.view">
        <field name="name">ai.config.form</field>
        <field name="model">ai.configuration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Activate" type="object" class="btn-primary"
                            invisible="state == 'active'"/>
                    <button name="action_disable" string="Deactivate" type="object" class="btn-primary"
                            invisible="state == 'disable'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,disable"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="url"/>
                            <field name="api_key"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ai_config_tree" model="ir.ui.view">
        <field name="name">ai.config.tree</field>
        <field name="model">ai.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="url" />
            </list>
        </field>
    </record>

    <record id="ai_config_action" model="ir.actions.act_window">
        <field name="name">AI Config</field>
        <field name="res_model">ai.configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="ai_config_menu" name="Credentials" action="ai_config_action" parent="ff_ai_module.ai_insight_menu"
              sequence="100"/>
</odoo>