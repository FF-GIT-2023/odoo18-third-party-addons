<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ai_insight_form" model="ir.ui.view">
        <field name="name">ai.insight.form</field>
        <field name="model">ai.insight</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="switch_bool" invisible="1"/>
                        <field name="prompt_text" readonly="switch_bool != False"/>
                        <button name="action_generate_response" string="Submit Prompt" type="object" class="btn-primary"
                                invisible="switch_bool != False"/>
                    </group>
                    <group>
                    </group>
                    <group>
                        <field name="response_text" />
                    </group>
                </group>
            </form>
        </field>
    </record>
     <record id="ai_insight_tree" model="ir.ui.view">
        <field name="name">ai.insight.tree</field>
        <field name="model">ai.insight</field>
        <field name="arch" type="xml">
            <list>
                <field name="prompt_text" />
            </list>
        </field>
    </record>

    <record id="ai_insight_action" model="ir.actions.act_window">
        <field name="name">AI Insight</field>
        <field name="res_model">ai.insight</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="ai_insight_menu" name="AI Insight" action="ai_insight_action" sequence="200"/>
</odoo>
