<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_lot_expiration_warning" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pos.lot.expiration.warning</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='product_and_category_block']" position="inside">
                <setting id="pos_lot_expiration_warning_setting"
                         string="Lot Expiration Warning"
                         help="Warn cashiers when they select an expired lot or serial number in POS.">
                    <field name="pos_lot_expiration_warning"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
