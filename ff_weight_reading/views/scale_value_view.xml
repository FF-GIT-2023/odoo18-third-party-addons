<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="scale_value_form_id" model="ir.ui.view">
        <field name="name">scale.value.form</field>
        <field name="model">scale.value</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="current_date"/>
                            <field name="scale_value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="scale_value_tree_id" model="ir.ui.view">
        <field name="name">scale.value.tree</field>
        <field name="model">scale.value</field>
        <field name="arch" type="xml">
            <list>
                <field name="current_date"/>
                <field name="scale_value"/>
            </list>
        </field>
    </record>
    <record id="scale_value_action" model="ir.actions.act_window">
        <field name="name">Scale Value</field>
        <field name="res_model">scale.value</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="scale_value_tree_id"/>
        <field name="target">current</field>
    </record>

    <menuitem id="scale_value_menu_id"
              action="scale_value_action"
              name="Scale Data"
              parent="point_of_sale.menu_point_config_product"
              sequence="100"/>
</odoo>