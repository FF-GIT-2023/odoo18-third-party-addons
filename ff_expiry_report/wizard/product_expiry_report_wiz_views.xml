<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_expiry_report_view_form" model="ir.ui.view">
        <field name="name">product.expiry.report.view.form</field>
        <field name="model">product.expiry.report.wiz</field>
        <field name="arch" type="xml">
            <form>

                <group>
                    <group>
                        <field name="start_date" />
                        <field name="tracking_wise" />
                        <field name="expiry_type" />
                        <field name="product_categ_ids" widget="many2many_tags" />
                    </group>

                    <group>
                        <field name="end_date" />
                        <field name="company_ids" widget="many2many_tags" />
                        <field name="expiry_days" />
                    </group>
                </group>

                <group>
<!--                    <field name="company_id" invisible="1" />-->
                    <field name="location_id" invisible="tracking_wise != 'location_wise'"/>
                </group>
                <footer>
                    <button name="generate_pdf_expiry_report" string="PDF Report" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" />
                </footer>

            </form>
        </field>
    </record>

    <record id="product_expiry_report_action" model="ir.actions.act_window">
        <field name="name">Product Expiring Report</field>
        <field name="res_model">product.expiry.report.wiz</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="product_batch_report_menu" name="Product Expiry Report" action="product_expiry_report_action"
              parent="stock.menu_warehouse_report" sequence="200"/>
</odoo>
